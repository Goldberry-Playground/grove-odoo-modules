<?xml version="1.0" encoding="utf-8"?>
<!-- Weekly 'This week at the Grove' calendar digest (GOL-3830, phase B). -->
<!-- noupdate="1" (same rationale as grove_headless/data/order_rollup_cron.xml):
     the fixed past nextcall below is a *first-run* seed, not a schedule to
     re-apply on every upgrade. Under the default noupdate="0" every
     `-u grove_calendar` would rewrite the live ir.cron row — including nextcall
     — back to the past and fire the digest off-schedule on the next tick. With
     noupdate="1" an upgrade leaves the existing row's advanced nextcall alone;
     the seed only applies on a fresh install. A future schedule change is then a
     migration, matching Odoo's own base crons. -->
<odoo noupdate="1">
    <record id="ir_cron_weekly_calendar_digest" model="ir.cron">
        <field name="name">Grove: weekly calendar digest</field>
        <field name="model_id" ref="model_grove_calendar_digest"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_weekly_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <!-- First-run seed: Monday 12:00 UTC (07:00/08:00 Eastern), so the post
             lands when people are starting their week rather than at 03:00 ET
             like the 08:00-UTC order rollup. 2026-09-07 is a Monday, so Odoo's
             advance-by-interval keeps every subsequent run on Monday 12:00 UTC.
             Fresh-install only (noupdate). -->
        <field name="nextcall">2026-09-07 12:00:00</field>
        <!-- NB: ir.cron.doall was removed in Odoo 17+; setting it fails module
             load with "Invalid field 'doall'" on Odoo 19. -->
        <field name="active" eval="True"/>
    </record>
</odoo>
