<?xml version="1.0" encoding="UTF-8" ?>
<!-- Consult service menu products (GOL-3575, spec C.6).

     All company 3 (At The Grove Nursery), sale_ok, website_published False,
     grove_gate_exempt True, no tax. type="service", so none counts as a tree for
     the deposit rule, the bundle tree count, the box plan or compliance — every
     tree-counting path filters on storable products, which a service is not
     (same reasoning as product_planting_consult; asserted in
     test_consult_products.py).

     Prices are reference values from the public list; Josh edits them on the
     records. noupdate="1" so a module upgrade never resets those edits.

     product_planting_consult (the $500-threshold entry) already exists in
     data/consult_product.xml and is not redefined here. -->
<odoo noupdate="1">
    <record id="consult_strategy_hour" model="product.template">
        <field name="name">Strategy session, per hour</field>
        <field name="type">service</field>
        <field name="list_price">100.0</field>
        <field name="sale_ok" eval="True" />
        <field name="purchase_ok" eval="False" />
        <field name="website_published" eval="False" />
        <field name="grove_gate_exempt" eval="True" />
        <field name="company_id" ref="company_nursery" />
        <field name="taxes_id" eval="[(6, 0, [])]" />
        <field name="description_sale">Strategy session, per hour. Two-hour minimum in person.</field>
    </record>
    <record id="consult_basemaps" model="product.template">
        <field name="name">Basemaps for a strategy session</field>
        <field name="type">service</field>
        <field name="list_price">150.0</field>
        <field name="sale_ok" eval="True" />
        <field name="purchase_ok" eval="False" />
        <field name="website_published" eval="False" />
        <field name="grove_gate_exempt" eval="True" />
        <field name="company_id" ref="company_nursery" />
        <field name="taxes_id" eval="[(6, 0, [])]" />
        <field name="description_sale">Basemaps prepared for a strategy session. Credited against a plan.</field>
    </record>
    <record id="consult_plan" model="product.template">
        <field name="name">Whole-property plan</field>
        <field name="type">service</field>
