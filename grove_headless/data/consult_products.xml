        <field name="grove_gate_exempt" eval="True" />
        <field name="company_id" ref="company_nursery" />
        <field name="taxes_id" eval="[(6, 0, [])]" />
        <field name="description_sale">Whole-property plan. Fixed on the quote after the visit.</field>
    </record>
    <record id="consult_workbook" model="product.template">
