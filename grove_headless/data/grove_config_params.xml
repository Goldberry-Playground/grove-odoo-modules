<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- Global default preorder cap (GOL-2171). A product sells out once its
         preorder count exceeds its cap; this is the default cap for any product
         without a per-template override (product.template.grove_preorder_cap).

         Seed = 50, ratified by Josh 2026-09-07 ("default for any new product is
         50"). noupdate="1" so an admin can adjust the number in Odoo
         (Settings > Technical > System Parameters) and the edit survives module
         upgrades — that adjustability is the explicit requirement, so 50 must
         never be a code constant. A per-product override on the product form
         beats this global; leaving the override at 0 inherits this value. -->
    <record id="preorder_cap_default_param" model="ir.config_parameter">
        <field name="key">grove_headless.preorder_cap_default</field>
        <field name="value">50</field>
    </record>

    <!-- Pirate Ship auto-buy switch (GOL-2271). "0" = review-only: the
         grove-shipper runner pulls + uploads + price-checks a batch but STOPS
         at the Pirate Ship review screen (no label is bought unless invoked
         with the buy flag). Flip to "1" in Settings / Technical / System Parameters to
         let the scheduled run buy without a deploy. noupdate="1" so the operator
         edit survives module upgrades — this adjustability is the requirement,
         so the seed must never be a code constant. Read by the runner via
         GET /grove/api/v1/labels/config. -->
    <record id="pirateship_autobuy_param" model="ir.config_parameter">
        <field name="key">grove_headless.pirateship_autobuy</field>
        <field name="value">0</field>
    </record>

    <!-- Perenual daily call budget (GOL-2391). The Fetch-facts button enqueues a
         grove.enrich.job per plant; the process_enrich_jobs cron drains them
         oldest-first, spending at most this many real Perenual HTTP calls per
         UTC day (2 calls per plant, or 1 when the species id is already cached).
         Seed = 100 (free-tier headroom). noupdate="1" so an operator can raise
         or lower it in Settings / Technical / System Parameters without a
         deploy — that adjustability is the requirement, so 100 is never a code
         constant (the DEFAULT_DAILY_BUDGET in mapping.py is only the fallback
         when the row is missing). -->
    <record id="perenual_daily_budget_param" model="ir.config_parameter">
        <field name="key">grove_headless.perenual_daily_budget</field>
        <field name="value">100</field>
    </record>

</odoo>
