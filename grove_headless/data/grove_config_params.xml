<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- Global default preorder cap (GOL-2171). A product sells out once its
         preorder count exceeds its cap; this is the default cap for any product
         without a per-template override (product.template.grove_preorder_cap).

         Seed = 50, ratified by Josh 2026-09-07 ("default for any new product is
         50"). noupdate="1" so an admin can adjust the number in Odoo
         (Settings > Technical > System Parameters) and the edit survives module
         upgrades — that adjustability is the explicit requirement, so 50 must
         never be a code constant. A per-product override on the product form
         beats this global; leaving the override at 0 inherits this value. -->
    <record id="preorder_cap_default_param" model="ir.config_parameter">
        <field name="key">grove_headless.preorder_cap_default</field>
        <field name="value">50</field>
    </record>

    <!-- Pirate Ship auto-buy switch (GOL-2271). "0" = review-only: the
         grove-shipper runner pulls + uploads + price-checks a batch but STOPS
         at the Pirate Ship review screen (no label is bought unless invoked
         with the buy flag). Flip to "1" in Settings / Technical / System Parameters to
         let the scheduled run buy without a deploy. noupdate="1" so the operator
         edit survives module upgrades — this adjustability is the requirement,
         so the seed must never be a code constant. Read by the runner via
         GET /grove/api/v1/labels/config. -->
    <record id="pirateship_autobuy_param" model="ir.config_parameter">
        <field name="key">grove_headless.pirateship_autobuy</field>
        <field name="value">0</field>
    </record>

    <!-- Perenual daily call budget (GOL-2391). The Fetch-facts button enqueues a
         grove.enrich.job per plant; the process_enrich_jobs cron drains them
         oldest-first, spending at most this many real Perenual HTTP calls per
         UTC day (2 calls per plant, or 1 when the species id is already cached).
         Seed = 100 (free-tier headroom). noupdate="1" so an operator can raise
         or lower it in Settings / Technical / System Parameters without a
         deploy — that adjustability is the requirement, so 100 is never a code
         constant (the DEFAULT_DAILY_BUDGET in mapping.py is only the fallback
         when the row is missing). -->
    <record id="perenual_daily_budget_param" model="ir.config_parameter">
        <field name="key">grove_headless.perenual_daily_budget</field>
        <field name="value">100</field>
    </record>

    <!-- Login of the Odoo user the grove-content-drafter routine authenticates
         as (GOL-2541). The product form reads this user's login_date to tell
         whether the drafter is live; while it is blank (or points at a user that
         does not exist), the Draft status panel says "Routine not configured" so
         a Request-content-draft never sits forever with no indication that
         nothing will pick it up. Set it in Settings / Technical / System
         Parameters once the drafter user exists (QA has none today). noupdate="1"
         so the operator's value survives module upgrades. -->
    <record id="content_drafter_login_param" model="ir.config_parameter">
        <field name="key">grove_headless.content_drafter_login</field>
        <field name="value"></field>
    </record>

    <!-- Already-labelled guard threshold in days (GOL-3083). A batch row whose
         order has been awaiting a label longer than this is "likely already
         shipped by hand" (the LB-20261005-01 duplicate-label failure: four orders
         shipped + delivered in September on hand-bought Pirate Ship labels that
         were never recorded in Odoo, so the builder re-bought a second label).
         Such a row is held OUT of the exported CSV until an operator explicitly
         acknowledges it. Seed = 14. noupdate="1" so an operator can tune it in
         Settings / Technical / System Parameters without a deploy — that
         adjustability is the requirement, so 14 is never a code constant (the
         DEFAULT_AGE_ACK_DAYS in label_batch.py is only the missing-row fallback). -->
    <record id="label_batch_age_ack_days_param" model="ir.config_parameter">
        <field name="key">grove_headless.label_batch_age_ack_days</field>
        <field name="value">14</field>
    </record>

    <!-- Free planting-consult offer threshold in dollars (GOL-3381 spec D.2).
         The $0 consult line is offered at checkout when the goods subtotal
         (after promotions, before shipping and tax) is at or above this value,
         OR the cart carries a grove_consult_built mix. Seed = 500.00.
         Set it to 0 in Settings / Technical / System Parameters to switch the
         subtotal offer OFF without a deploy (the kill switch) — the consult-built
         path stays independent of it. noupdate="1" so the operator's value
         survives module upgrades; GROVE_CONSULT_THRESHOLD_DEFAULT in
         sale_order.py is only the fallback when the row is missing. -->
    <record id="consult_threshold_param" model="ir.config_parameter">
        <field name="key">grove_headless.consult_threshold</field>
        <field name="value">500.00</field>
    </record>

    <!-- Planting-consult booking link (GOL-3381 spec D.3). A Google Calendar
         appointment-schedule URL owned by Josh (Wesley as backup); no credential,
         no API. The order-confirmation booking email links here with ?order=<name>
         appended so the calendar description shows which order the call is for.
         Blank by default — Josh pastes the schedule URL in Settings / Technical /
         System Parameters; while it is blank the booking email is skipped (logged)
         rather than linking nowhere. noupdate="1" so the operator value survives
         module upgrades. -->
    <record id="consult_booking_url_param" model="ir.config_parameter">
        <field name="key">grove_headless.consult_booking_url</field>
        <field name="value"></field>
    </record>

    <!-- Planner learning-loop kill switch (GOL-3549 spec B / F). The public
         planner routes (/grove/api/v1/planner/signal, /suggest, /save,
         /dispute, /propose) return 503 when this is false, which the storefront
         treats as a silent no-op. Default True. Flip to False in Settings /
         Technical / System Parameters to stop accepting learning signals without
         a deploy (the kill switch is the requirement, so the default must never
         be a code constant). noupdate="1" so the operator value survives module
         upgrades. The whole /plan page has its own switch (PLANNER_ENABLED,
         section F); this one governs only the learning writes. -->
    <record id="planner_learning_enabled_param" model="ir.config_parameter">
        <field name="key">grove_headless.planner_learning_enabled</field>
        <field name="value">True</field>
    </record>

</odoo>
