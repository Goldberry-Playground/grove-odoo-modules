<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Hold nudges and spring zone warnings. Runs hourly and does nothing before
         8am New York time, so notices land each morning (a hold nudge repeats
         until someone answers it; each zone warning goes out once per year).
         noupdate="1": an upgrade must not rewrite the live schedule. -->
    <record id="ir_cron_grove_order_nudges" model="ir.cron">
        <field name="name">Grove: order nudges and zone warnings</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_grove_order_ops()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
