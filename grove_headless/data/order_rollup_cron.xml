<?xml version="1.0" encoding="utf-8"?>
<!-- Weekly order/preorder rollup digest (GOL-1978). -->
<odoo>
    <record id="ir_cron_weekly_order_digest" model="ir.cron">
        <field name="name">Grove: weekly order/preorder rollup digest</field>
        <field name="model_id" ref="model_grove_order_rollup"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_weekly_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <!-- Monday 08:00 UTC — before the team starts their week -->
        <field name="nextcall">2026-09-07 08:00:00</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
