<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- GOL-2053/2054/3011: automatically re-attempt shipped-but-unsettled orders
         that are still auto-retryable. Selects BOTH settlement_failed (card
         decline) and settlement_error (known-not-charged / outcome-unknown gateway
         error); the latter reconciles with Stripe before charging so a retry never
         double-charges. Skips SCA (authentication_required) orders — an off-session
         retry cannot clear them — and honours a per-order exponential backoff.
         Stops at grove_headless.settlement_max_retries (default 3), after which the
         order is manual-only (the Retry settlement server action) and stays in the
         ops queue via its Discord alert (never auto-cancel — CEO ruling GOL-2054).
         Daily cadence: a once-a-day retry clears a transient hold without hammering
         a hard-declined card. -->
    <record id="ir_cron_grove_retry_settlements" model="ir.cron">
        <field name="name">Grove: retry failed ship-time settlements</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_settlements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
