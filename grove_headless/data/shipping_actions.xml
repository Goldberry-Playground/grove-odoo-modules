<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_grove_buy_shipping_labels" model="ir.actions.server">
    <field name="name">Grove: Buy Shipping Label(s)</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">records.action_buy_shipping_labels()</field>
  </record>

  <!-- Mark a farm-pickup order collected AND settle its deferred balance (GOL-2893).
       The pickup twin of the Discord "Mark Shipped" button, exposed on the order
       list/form so Josh/Wesley can collect + charge the remainder from Odoo today
       without waiting on a Discord button. Settlement runs ONLY on the real
       collected transition and is best-effort — a decline flags settlement_failed
       and duns, never rolls back the collected state. A non-pickup order is refused
       by the model guard (logged, no write). Iterates so a multi-select is safe. -->
  <record id="action_grove_mark_collected" model="ir.actions.server">
    <field name="name">Mark collected (pickup)</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
for order in records:
    order._grove_mark_collected_and_settle()
    </field>
  </record>

  <!-- Assign deposit-paid orders to a ship wave (GOL-2895). The multi-select
       operator entry to the ship wave: a sold-out deposit order (GOL-2233 took
       only the $10) sits at deposit_paid until it is waved, and before this it
       had no caller at all. Iterates so a multi-select is safe; pickup orders
       are refused by the model guard (logged, no write). No wave ref from the
       list action — the bearer endpoint carries the optional ref. -->
  <record id="action_grove_assign_wave" model="ir.actions.server">
    <field name="name">Assign to ship wave</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
for order in records:
    order.action_grove_assign_wave()
    </field>
  </record>

  <!-- Mark shipped + settle + notify from Odoo (GOL-2895), so the ship flow does
       not depend on the Discord "Mark Shipped" button being wired. Runs the SAME
       _operator_mark_shipped orchestration: canonical shipped transition +
       ship-time settlement (the deferred balance is captured off-session) + one
       branded shipment email. Best-effort settlement never rolls back shipped;
       a pickup order is refused by the model guard. Iterates for multi-select. -->
  <record id="action_grove_mark_shipped" model="ir.actions.server">
    <field name="name">Mark shipped (settle + notify)</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
for order in records:
    order._grove_mark_shipped_and_settle()
    </field>
  </record>

  <!-- Retry settlement (GOL-3011). The in-Odoo replacement for the odoo-shell
       _grove_settle_at_ship() workaround: re-runs the reconcile-then-charge
       settlement on every selected order and posts the result to the chatter.
       Callable on a shipped/collected order and on settlement_failed /
       settlement_error orders; settle_order_at_ship no-ops (already_settled /
       not_applicable) for anything with nothing to charge, so a stray selection is
       harmless. Concurrency-safe against the retry cron via the row lock inside the
       settlement engine; the outcome-unknown bucket reconciles with Stripe before
       charging so a manual retry never double-charges. Iterates for multi-select. -->
  <record id="action_grove_retry_settlement" model="ir.actions.server">
    <field name="name">Retry settlement</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">records.action_grove_retry_settlement()</field>
  </record>

  <!-- Manual "build the open Pirate Ship batch" trigger (GOL-2271). Rolls every
       eligible order (paid ship order awaiting a label / waved preorder) into
       the one open batch and opens its form so the operator can Export the CSV.
       Idempotent — re-running returns the same open batch with fresh rows. -->
  <record id="action_grove_build_label_batch" model="ir.actions.server">
    <field name="name">Build Pirate Ship batch</field>
    <field name="model_id" ref="model_grove_label_batch"/>
    <field name="state">code</field>
    <field name="code">
batch = model.build_open_batch(env.company)
action = {
    "type": "ir.actions.act_window",
    "res_model": "grove.label.batch",
    "res_id": batch.id,
    "view_mode": "form",
    "views": [(False, "form")],
}
    </field>
  </record>

  <menuitem
    id="menu_grove_build_label_batch"
    name="Build Pirate Ship batch"
    parent="sale.sale_menu_root"
    action="action_grove_build_label_batch"
    sequence="91"
  />
</odoo>
