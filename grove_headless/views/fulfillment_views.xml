<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Fulfilment badge on the transfer form: warehouse staff must see
         "Farm pickup" vs "Shipping" without opening the sale order. Hidden on
         pickings with no fulfilment (receipts, internal moves, legacy orders
         that predate grove_fulfillment). -->
    <record id="view_picking_form_grove_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.form.grove.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="grove_fulfillment"
                    widget="badge"
                    invisible="not grove_fulfillment"
                    decoration-warning="grove_fulfillment == 'pickup'"
                    decoration-info="grove_fulfillment == 'ship'"
                />
                <!-- Compliance substitution the box must physically carry
                     (GOL-2237): shown on the transfer so the packer sees the
                     swap on screen as well as on the printed delivery slip. -->
                <field
                    name="grove_substitution_note"
                    readonly="1"
                    invisible="not grove_substitution_note"
                />
            </xpath>
        </field>
    </record>

    <!-- Same badge as an optional column in the transfers list. -->
    <record id="vpicktree_grove_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.list.grove.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="grove_fulfillment"
                    optional="show"
                    widget="badge"
                    decoration-warning="grove_fulfillment == 'pickup'"
                    decoration-info="grove_fulfillment == 'ship'"
                />
            </xpath>
        </field>
    </record>

    <!-- Filters so "show me today's pickups" is one click. -->
    <record id="view_picking_search_grove_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.search.grove.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="grove_pickup"
                    string="Farm pickup"
                    domain="[('grove_fulfillment', '=', 'pickup')]"
                />
                <filter
                    name="grove_ship"
                    string="Shipping"
                    domain="[('grove_fulfillment', '=', 'ship')]"
                />
            </xpath>
        </field>
    </record>

    <!-- Mirror on the sale order form (Other Info tab) so back-office staff
         see the fulfilment there too. -->
    <record id="view_order_form_grove_fulfillment" model="ir.ui.view">
        <field name="name">sale.order.form.grove.fulfillment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="grove_fulfillment"
                    widget="badge"
                    invisible="not grove_fulfillment"
                    decoration-warning="grove_fulfillment == 'pickup'"
                    decoration-info="grove_fulfillment == 'ship'"
                />
                <!-- Free $0 planting-consult flag (GOL-3381 spec D.3): shown only
                     when set so Wesley sees "book the call" at a glance. -->
                <field
                    name="grove_consult_requested"
                    readonly="1"
                    invisible="not grove_consult_requested"
                    string="Consult requested"
                />
            </xpath>
            <!-- Consult-built compliance surface (GOL-3007). Editable, under the
                 order lines on the default tab — where Wesley works the order,
                 not buried away. For a consult-built mix (134/135) the balance
                 cannot settle / ship until this is filled; see
                 _grove_assert_consult_compliance. Harmless on every other order
                 (it also carries the warehouse bundle-substitution note). -->
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Compliance check / substitutions"
                       name="grove_compliance_check">
                    <!-- Consult-built deposit deferral banner (GOL-3019). When a
                         consult-built mix took its deposit into a constrained
                         state, Wesley sees the destination here, right above the
                         note he must fill, without opening the chatter. -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not grove_consult_compliance_deferred">
                        ⏸️ Consult compliance deferred for destination
                        <field name="grove_consult_deferred_state" class="oe_inline" readonly="1" />
                        — agree a compliant species list with the customer, then record the
                        check below before the balance can be charged or the order shipped.
                    </div>
                    <field name="grove_consult_compliance_deferred" invisible="1" />
                    <field
                        name="grove_substitution_note"
                        nolabel="1"
                        placeholder="Destination state, species list checked against the carve-outs, any substitutions, and who cleared it. See the SOP in the product's Internal Notes."
                    />
                    <!-- Planner plan carried from the storefront quiz (GOL-3381
                         spec C.4). Read-only: the SOP step 3 (swap or drop, tell
                         the customer what changed) starts from this list. Hidden
                         on every order without a carried plan. -->
                    <field name="grove_planner_plan_summary"
                           string="Planner plan (from the storefront quiz)"
                           readonly="1"
                           invisible="not grove_planner_plan_summary" />
                    <field name="grove_planner_plan_url"
                           widget="url"
                           readonly="1"
                           string="Customer's quiz"
                           invisible="not grove_planner_plan_url" />
                </group>
            </xpath>
            <!-- Printify fulfilment state (GOL-3314). Shown only on a Printify
                 order so the back office can see where the print-on-demand push
                 is, and a sales manager can re-queue a push that failed. -->
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Printify" name="grove_printify" invisible="not grove_is_printify">
                    <field name="grove_is_printify" invisible="1" />
                    <field name="printify_order_id" />
                    <field name="printify_state" />
                    <field name="printify_push_attempts" />
                    <button name="action_grove_retry_printify_push" type="object" string="Retry Printify push"
                            class="btn-danger btn-sm" icon="fa-refresh" invisible="printify_state != 'push_failed'"
                            groups="sales_team.group_sale_manager" />
                </group>
            </xpath>
            <!-- Order attribution (GOL-4077): where the buyer came from, captured
                 at checkout from the storefront `attribution` payload. Read-only
                 and shown only when the order actually carries attribution, so it
                 never clutters a POS / walk-in order. Revenue-by-channel is read
                 through the /orders/attribution endpoint; this is the per-order
                 view the "shows them on the order in Odoo" acceptance reads. -->
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Attribution" name="grove_attribution"
                       invisible="not grove_utm_source and not grove_utm_medium and not grove_utm_campaign and not grove_landing_page and not grove_referrer">
                    <group>
                        <field name="grove_utm_source" readonly="1" invisible="not grove_utm_source" />
                        <field name="grove_utm_medium" readonly="1" invisible="not grove_utm_medium" />
                        <field name="grove_utm_campaign" readonly="1" invisible="not grove_utm_campaign" />
                        <field name="grove_utm_content" readonly="1" invisible="not grove_utm_content" />
                        <field name="grove_utm_term" readonly="1" invisible="not grove_utm_term" />
                    </group>
                    <group>
                        <field name="grove_landing_page" readonly="1" invisible="not grove_landing_page" />
                        <field name="grove_referrer" readonly="1" invisible="not grove_referrer" />
                        <field name="grove_marketing_tags_eligible" readonly="1" />
                        <field name="grove_ga_client_id" readonly="1" invisible="not grove_ga_client_id" />
                        <field name="grove_ga_session_id" readonly="1" invisible="not grove_ga_session_id" />
                        <field name="grove_fbp" readonly="1" invisible="not grove_fbp" />
                        <field name="grove_fbc" readonly="1" invisible="not grove_fbc" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- "Consult requested" as an optional column on the sale-order list (GOL-3381
         spec D.3) so Wesley can filter the week's bookings without opening each
         order. -->
    <record id="view_order_tree_grove_consult" model="ir.ui.view">
        <field name="name">sale.order.list.grove.consult</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="grove_consult_requested" optional="hide" widget="boolean" />
            </xpath>
        </field>
    </record>

</odoo>
