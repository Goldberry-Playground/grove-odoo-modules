<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Fulfilment badge on the transfer form: warehouse staff must see
         "Farm pickup" vs "Shipping" without opening the sale order. Hidden on
         pickings with no fulfilment (receipts, internal moves, legacy orders
         that predate grove_fulfillment). -->
    <record id="view_picking_form_grove_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.form.grove.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="grove_fulfillment"
                    widget="badge"
                    invisible="not grove_fulfillment"
                    decoration-warning="grove_fulfillment == 'pickup'"
                    decoration-info="grove_fulfillment == 'ship'"
                />
                <!-- Compliance substitution the box must physically carry
                     (GOL-2237): shown on the transfer so the packer sees the
                     swap on screen as well as on the printed delivery slip. -->
                <field
                    name="grove_substitution_note"
                    readonly="1"
                    invisible="not grove_substitution_note"
                />
            </xpath>
        </field>
    </record>

    <!-- Same badge as an optional column in the transfers list. -->
    <record id="vpicktree_grove_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.list.grove.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="grove_fulfillment"
                    optional="show"
                    widget="badge"
                    decoration-warning="grove_fulfillment == 'pickup'"
                    decoration-info="grove_fulfillment == 'ship'"
                />
            </xpath>
        </field>
    </record>

    <!-- Filters so "show me today's pickups" is one click. -->
    <record id="view_picking_search_grove_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.search.grove.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="grove_pickup"
                    string="Farm pickup"
                    domain="[('grove_fulfillment', '=', 'pickup')]"
                />
                <filter
                    name="grove_ship"
                    string="Shipping"
                    domain="[('grove_fulfillment', '=', 'ship')]"
                />
            </xpath>
        </field>
    </record>

    <!-- Mirror on the sale order form (Other Info tab) so back-office staff
         see the fulfilment there too. -->
    <record id="view_order_form_grove_fulfillment" model="ir.ui.view">
        <field name="name">sale.order.form.grove.fulfillment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="grove_fulfillment"
                    widget="badge"
                    invisible="not grove_fulfillment"
                    decoration-warning="grove_fulfillment == 'pickup'"
                    decoration-info="grove_fulfillment == 'ship'"
                />
            </xpath>
            <!-- Consult-built compliance surface (GOL-3007). Editable, under the
                 order lines on the default tab — where Wesley works the order,
                 not buried away. For a consult-built mix (134/135) the balance
                 cannot settle / ship until this is filled; see
                 _grove_assert_consult_compliance. Harmless on every other order
                 (it also carries the warehouse bundle-substitution note). -->
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Compliance check / substitutions"
                       name="grove_compliance_check">
                    <!-- Consult-built deposit deferral banner (GOL-3019). When a
                         consult-built mix took its deposit into a constrained
                         state, Wesley sees the destination here, right above the
                         note he must fill, without opening the chatter. -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not grove_consult_compliance_deferred">
                        ⏸️ Consult compliance deferred for destination
                        <field name="grove_consult_deferred_state" class="oe_inline" readonly="1" />
                        — agree a compliant species list with the customer, then record the
                        check below before the balance can be charged or the order shipped.
                    </div>
                    <field name="grove_consult_compliance_deferred" invisible="1" />
                    <field
                        name="grove_substitution_note"
                        nolabel="1"
                        placeholder="Destination state, species list checked against the carve-outs, any substitutions, and who cleared it. See the SOP in the product's Internal Notes."
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
