<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Record a hand-bought label wizard (GOL-2895). Reached from the sale.order
       *Action* menu (binding below) so the operator opens it on the order whose
       label they bought by hand in Pirate Ship; it advances that order to
       label_purchased via action_grove_record_hand_label. -->
  <record id="view_grove_hand_label_form" model="ir.ui.view">
    <field name="name">grove.hand.label.form</field>
    <field name="model">grove.hand.label</field>
    <field name="arch" type="xml">
      <form string="Record hand-bought label">
        <group>
          <field name="order_id"/>
          <field name="tracking_number"/>
          <field name="carrier"/>
          <field name="actual_cost"/>
        </group>
        <footer>
          <button string="Record label" name="action_record" type="object" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_grove_hand_label" model="ir.actions.act_window">
    <field name="name">Record hand-bought label</field>
    <field name="res_model">grove.hand.label</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_view_types">form</field>
  </record>
</odoo>
