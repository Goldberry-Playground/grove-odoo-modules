<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Hold order wizard: date + reason, written through action_grove_set_hold. -->
    <record id="view_grove_order_hold_form" model="ir.ui.view">
        <field name="name">grove.order.hold.form</field>
        <field name="model">grove.order.hold</field>
        <field name="arch" type="xml">
            <form string="Hold order">
                <p class="text-muted">A hold only reminds us to wait. It never ships, charges or
                   emails anything.</p>
                <group>
                    <field name="order_id" />
                    <field name="hold_until" />
                    <field name="reason" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Hold order"
                            class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_grove_hold_order" model="ir.actions.act_window">
        <field name="name">Hold order</field>
        <field name="res_model">grove.order.hold</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <!-- "On hold" filter (and a lane grouping) on the orders search view. -->
    <record id="view_sales_order_filter_grove_hold" model="ir.ui.view">
        <field name="name">sale.order.search.grove.hold</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter name="grove_on_hold" string="On hold" domain="[('grove_hold_until', '!=', False)]" />
                <filter name="group_grove_lane" string="Lane" context="{'group_by': 'grove_lane'}" />
            </xpath>
        </field>
    </record>

    <!-- Read-only lane / hold block on the order form. Hold fields are never
         editable here; the Hold order and Release hold actions change them. -->
    <record id="view_order_form_grove_hold" model="ir.ui.view">
        <field name="name">sale.order.form.grove.hold</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="grove_lane" readonly="1" invisible="grove_lane in ('none', False)" />
                <field name="grove_hold_until" readonly="1" invisible="not grove_hold_until" />
                <field name="grove_hold_reason" readonly="1" invisible="not grove_hold_until" />
                <field name="grove_hold_set_by" readonly="1" invisible="not grove_hold_until" />
            </xpath>
        </field>
    </record>

</odoo>
