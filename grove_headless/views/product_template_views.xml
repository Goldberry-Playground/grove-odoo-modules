<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Extend the product template form to show Grove headless fields -->
    <record id="product_template_form_view_grove" model="ir.ui.view">
        <field name="name">product.template.form.grove_headless</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_grove_publish_events"
                    class="oe_stat_button"
                    icon="fa-cloud-upload"
                    invisible="grove_publish_event_count == 0"
                >
                    <field name="grove_publish_event_count" widget="statinfo" string="Publishes" />
                </button>
            </xpath>
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Grove Headless" name="grove_headless">
                    <group>
                        <group string="Storefront">
                            <field name="grove_featured" />
                        </group>
                        <group string="SEO">
                            <field name="grove_seo_description" />
                        </group>
                    </group>
                    <group string="Growing Facts" name="grove_growing_facts">
                        <div class="text-muted" colspan="2">
                            These feed the storefront spec block, and <b>USDA Zone</b>,
                            <b>Food Forest Layer</b> and <b>Sun Requirement</b> also drive
                            the /shop filter facets. Leave a field blank to omit it from
                            the storefront.
                        </div>
                        <group>
                            <field name="grove_botanical_name" />
                            <label for="grove_zone_min" string="USDA Zone (min / max)" />
                            <div class="o_row">
                                <field name="grove_zone_min" class="oe_inline" />
                                <span class="mx-1">–</span>
                                <field name="grove_zone_max" class="oe_inline" />
                            </div>
                            <field name="grove_layer" />
                            <field name="grove_sun" />
                        </group>
                        <group>
                            <field name="grove_mature_size" />
                            <field name="grove_spacing" />
                            <field name="grove_soil" />
                        </group>
                        <div class="text-muted" colspan="2">
                            USDA Zone min cannot exceed max — saving an inverted range is
                            rejected with a validation error.
                        </div>
                    </group>
                    <group string="Shipping (shippability gate — read the warning)" name="grove_shipping">
                        <div class="alert alert-warning" role="alert" colspan="2">
                            <b>Shipping Tier is the shippability gate, not a cosmetic tag.</b>
                            Only <b>Bareroot</b> products can ship (priced by Box Engine v2 per-box
                            zone rates). <b>Potted</b> is farm-pickup-only and <b>cannot be ordered
                            for shipping</b> — the checkout hard-fails any potted line. An untagged
                            product defaults to Potted so it can never ship undercharged. A variant
                            whose <b>Format</b> attribute is exactly "Bareroot" overrides this
                            template tier, so the <b>Effective Shipping Tier</b> shown per variant
                            below is the real outcome.
                        </div>
                        <field name="grove_shipping_tier" />
                        <field name="grove_tree_length" />
                        <separator string="Effective Shipping Tier per variant" colspan="2" />
                        <field name="product_variant_ids" nolabel="1" colspan="2" readonly="1">
                            <list string="Variants" create="false" delete="false">
                                <field name="display_name" string="Variant" />
                                <field name="grove_effective_shipping_tier" string="Ships as" />
                            </list>
                        </field>
                    </group>
                    <group string="Storefront Guide" name="grove_guide">
                        <field name="grove_guide_ready" />
                        <div class="text-muted" colspan="2">
                            The species guide shown on the storefront is the
                            <b>Description for the website</b> field (Sales tab). It is drafted
                            automatically and stays hidden until you tick <b>Guide Approved
                            for Storefront</b>. Until then the storefront shows a "coming soon"
                            placeholder. To re-draft, clear the description first.
                        </div>
                        <div colspan="2">
                            <button
                                name="action_publish_guide"
                                type="object"
                                string="Publish Guide to Storefront"
                                class="btn-primary"
                                icon="fa-cloud-upload"
                                invisible="not grove_guide_ready"
                                confirm="Publish this species guide to the storefront now? The site page will be revalidated."
                            />
                            <span class="text-muted" invisible="grove_guide_ready">
                                Approve the guide above to enable publishing.
                            </span>
                        </div>
                    </group>
                    <group string="Photo Quality (storefront)" name="grove_photo_quality">
                        <field name="grove_image_width" />
                        <field name="grove_image_height" />
                        <field name="grove_image_low_res" />
                        <div
                            class="alert alert-warning"
                            role="alert"
                            colspan="2"
                            invisible="not grove_image_low_res"
                        >
                            This product photo's long edge is below the 1600px storefront minimum,
                            so it will render blurry on the product page hero (~1056px) and grid
                            cards. Upload a higher-resolution source (re-shoot list tracked in
                            GOL-689).
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
