<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Extend the product template form to show Grove headless fields -->
    <record id="product_template_form_view_grove" model="ir.ui.view">
        <field name="name">product.template.form.grove_headless</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_grove_publish_events"
                    class="oe_stat_button"
                    icon="fa-cloud-upload"
                    invisible="grove_publish_event_count == 0"
                >
                    <field name="grove_publish_event_count" widget="statinfo" string="Publishes" />
                </button>
            </xpath>
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Grove Headless" name="grove_headless">
                    <!-- Listing-content gate readiness banner (GOL-2382). -->
                    <div class="alert alert-success" role="alert" invisible="grove_listing_missing" colspan="2">
                        <i class="fa fa-check-circle" title="Listing complete" role="img" /> <b>Listing complete</b> — this plant meets the
                        publish gate (all required facts, storefront description, approved care guide, facts reviewed).
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not grove_listing_missing or grove_gate_exempt"
                        colspan="2"
                    >
                        <b>Not ready to publish.</b> Still needed:
                        <field name="grove_listing_missing" class="oe_inline" nolabel="1" readonly="1" />
                    </div>
                    <!-- Growing guide review (2026-09-30). The storefront "Growing guide" is
                         website_description, which Odoo 19 exposes only through the website
                         builder, not the backend form, so there was nowhere to review a drafted
                         guide before approving it. Show it here, directly above the approval
                         checkbox, editable. -->
                    <separator string="Growing guide (storefront)" />
                    <field
                        name="website_description"
                        widget="html"
                        nolabel="1"
                        colspan="2"
                        placeholder="No growing guide yet. Use Request content draft, or write one here."
                    />
                    <group string="Listing Content Gate" name="grove_listing_gate">
                        <group>
                            <field name="grove_facts_reviewed" />
                            <field name="grove_guide_ready" />
                        </group>
                        <group>
                            <field name="grove_gate_exempt" />
                            <field name="grove_draft_state" />
                            <field name="grove_listing_complete" readonly="1" />
                        </group>
                        <div class="text-muted" colspan="2">
                            A plant in the <b>Plants</b> category cannot be published until this
                            listing is complete. Tick <b>Exempt from listing-content gate</b> for
                            bundles, gift cards and supplies. Any auto-fill or agent write to a fact
                            clears <b>Facts reviewed</b>.
                        </div>
                    </group>
                    <group>
                        <group string="Storefront">
                            <field name="grove_featured" />
                        </group>
                        <group string="Preorder Cap (GOL-2171)">
                            <field name="grove_preorder_cap" />
                            <field name="grove_preorder_count" />
                            <field name="grove_preorder_cap_effective" />
                            <field name="grove_preorder_cap_reached" />
                            <div class="text-muted" colspan="2">
                                Sells out once <b>Preorders</b> exceeds the
                                <b>Effective Cap</b>. Leave the override at 0 to
                                inherit the global default (System Parameter
                                <code>grove_headless.preorder_cap_default</code>).
                            </div>
                        </group>
                        <group string="SEO">
                            <field name="grove_seo_title" placeholder="Overrides the storefront &lt;title&gt; — leave blank for the default template" />
                            <field name="grove_seo_description" />
                        </group>
                    </group>
                    <group string="Growing Facts" name="grove_growing_facts">
                        <div class="text-muted" colspan="2">
                            These feed the storefront spec block, and <b>USDA Zone</b>,
                            <b>Food Forest Layer</b> and <b>Sun Requirement</b> also drive
                            the /shop filter facets. Leave a field blank to omit it from
                            the storefront.
                        </div>
                        <group>
                            <field name="grove_botanical_name" />
                            <label for="grove_zone_min" string="USDA Zone (min / max)" />
                            <div class="o_row">
                                <field name="grove_zone_min" class="oe_inline" />
                                <span class="mx-1">–</span>
                                <field name="grove_zone_max" class="oe_inline" />
                            </div>
                            <field name="grove_layer" />
                            <field name="grove_sun" />
                            <field name="grove_mature_size" />
                            <field name="grove_mature_spread" />
                            <field name="grove_spacing" />
                            <field name="grove_soil" />
                        </group>
                        <group>
                            <field name="grove_growth_rate" />
                            <field name="grove_watering" />
                            <field name="grove_bloom_season" />
                            <field name="grove_harvest_season" />
                            <field name="grove_wildlife" />
                            <field name="grove_pollination" />
                            <field name="grove_years_to_fruit" />
                            <field name="grove_chill_hours" />
                        </group>
                        <!-- Enrichment status panel (GOL-2541): what ran, how far
                             along, and did it succeed/fail — from the latest
                             grove.enrich.job, provenance, the drain cron and the
                             daily budget counter. -->
                        <field name="grove_enrich_failed" invisible="1" />
                        <field name="grove_draft_stale" invisible="1" />
                        <div
                            class="alert alert-danger"
                            role="alert"
                            colspan="2"
                            invisible="not grove_enrich_failed"
                        >
                            <i class="fa fa-exclamation-triangle" title="Enrichment failed" role="img" />
                            <b>Perenual enrichment failed.</b>
                            <field name="grove_enrich_failed_note" class="oe_inline" nolabel="1" readonly="1" />
                            <button
                                name="action_retry_enrich"
                                type="object"
                                string="Retry"
                                class="btn-danger btn-sm ms-2"
                                icon="fa-refresh"
                            />
                        </div>
                        <group string="Enrichment status" name="grove_enrich_status" colspan="2">
                            <field name="grove_enrich_status_usda" readonly="1" />
                            <field
                                name="grove_enrich_usda_fields"
                                readonly="1"
                                invisible="not grove_enrich_usda_fields"
                            />
                            <field name="grove_enrich_status_perenual" readonly="1" />
                            <field
                                name="grove_enrich_perenual_fields"
                                readonly="1"
                                invisible="not grove_enrich_perenual_fields"
                            />
                            <field
                                name="grove_enrich_hints_display"
                                string="Notes"
                                readonly="1"
                                invisible="not grove_enrich_hints_display"
                            />
                        </group>
                        <div colspan="2">
                            <button
                                name="action_fetch_facts"
                                type="object"
                                string="Fetch facts (USDA now + queue Perenual)"
                                class="btn-secondary"
                                icon="fa-download"
                                help="Fill empty growing facts from USDA PLANTS synchronously and
                                      enqueue Perenual enrichment (drained on the budgeted schedule).
                                      Only empty fields are written; each write is recorded in the
                                      chatter and clears the Facts Reviewed sign-off."
                            />
                            <button
                                name="action_request_draft"
                                type="object"
                                string="Request content draft"
                                class="btn-secondary"
                                icon="fa-pencil-square-o"
                                invisible="grove_gate_exempt or grove_draft_state == 'requested'"
                                help="Hand this listing to the Paperclip content-drafter routine: it
                                      writes the storefront description and care guide from the
                                      recorded facts (cited), then sets the draft state to 'Draft
                                      ready' for a human to review. Requires a botanical name and at
                                      least one fetched fact — run Fetch facts first."
                            />
                        </div>
                        <!-- Draft status panel + stalled banner (GOL-2541). -->
                        <div
                            class="alert alert-warning"
                            role="alert"
                            colspan="2"
                            invisible="not grove_draft_stale"
                        >
                            <i class="fa fa-clock-o" title="Draft stalled" role="img" />
                            <b>Draft has not arrived.</b> This request has been pending for over an
                            hour — confirm the content-drafter routine is running (see the status below).
                        </div>
                        <group string="Content draft status" name="grove_draft_status_panel" colspan="2">
                            <field name="grove_draft_status" nolabel="1" readonly="1" />
                        </group>
                        <group string="Facts provenance" colspan="2">
                            <field name="grove_usda_symbol" />
                            <field name="grove_perenual_id" />
                        </group>
                        <div class="text-muted" colspan="2">
                            USDA Zone min cannot exceed max — saving an inverted range is
                            rejected with a validation error.
                        </div>
                    </group>
                    <group string="Shipping (shippability gate — read the warning)" name="grove_shipping">
                        <div class="alert alert-warning" role="alert" colspan="2">
                            <b>Shipping Tier is the shippability gate, not a cosmetic tag.</b>
                            Only <b>Bareroot</b> products can ship (priced by Box Engine v2 per-box
                            zone rates). <b>Potted</b> is farm-pickup-only and <b>cannot be ordered
                            for shipping</b> — the checkout hard-fails any potted line. An untagged
                            product defaults to Potted so it can never ship undercharged. A variant
                            whose <b>Format</b> attribute is exactly "Bareroot" overrides this
                            template tier, so the <b>Effective Shipping Tier</b> shown per variant
                            below is the real outcome.
                        </div>
                        <field name="grove_shipping_tier" />
                        <field name="grove_tree_length" />
                        <field name="grove_pickup_only" />
                        <field name="grove_compliance_exempt" />
                        <field name="grove_compliance_note"
                               invisible="not grove_compliance_exempt"
                               placeholder="Who cleared it, when, for which components" />
                        <field name="grove_consult_built" />
                        <separator string="Effective Shipping Tier per variant" colspan="2" />
                        <field name="product_variant_ids" nolabel="1" colspan="2" readonly="1">
                            <list string="Variants" create="false" delete="false">
                                <field name="display_name" string="Variant" />
                                <field name="grove_effective_shipping_tier" string="Ships as" />
                            </list>
                        </field>
                    </group>
                    <group
                        string="Seed pre-orders"
                        name="grove_seed_preorders"
                        invisible="grove_shipping_tier != 'seed'"
                    >
                        <div class="alert alert-info" role="alert" colspan="2">
                            Seed nuts sell as a <b>$1 pre-order</b>: the shopper pays $1 at
                            checkout and the rest of the pack price, the actual label cost, the
                            handling fee and tax are charged when the order ships. Each seed
                            product has its own ship window, order-by date and season cap. After
                            the order-by date <b>or</b> once the cap is reached, the storefront
                            rolls over to next fall's harvest automatically and tells the shopper.
                        </div>
                        <field name="grove_seed_open" />
                        <field name="grove_seed_ship_start" />
                        <field name="grove_seed_ship_end" />
                        <field name="grove_seed_order_by" />
                        <field name="grove_seed_cap_lb" />
                        <field name="grove_seed_reserved_lb" />
                        <div class="text-muted" colspan="2">
                            Set the per-variant pack weight (lb) on each Pack size variant below;
                            reserved weight counts pack weight × quantity against the season cap.
                        </div>
                    </group>
                    <group string="Storefront Guide" name="grove_guide">
                        <div class="text-muted" colspan="2">
                            The species guide shown on the storefront is the
                            <b>Growing guide (storefront)</b> field above. It is drafted
                            automatically and stays hidden until you tick <b>Guide Approved
                            for Storefront</b>. Until then the storefront shows a "coming soon"
                            placeholder. To re-draft, clear the description first.
                        </div>
                        <div colspan="2">
                            <button
                                name="action_publish_guide"
                                type="object"
                                string="Publish Guide to Storefront"
                                class="btn-primary"
                                icon="fa-cloud-upload"
                                invisible="not grove_guide_ready"
                                confirm="Publish this species guide to the storefront now? The site page will be revalidated."
                            />
                            <span class="text-muted" invisible="grove_guide_ready">
                                Approve the guide above to enable publishing.
                            </span>
                        </div>
                    </group>
                    <group string="Photo Quality (storefront)" name="grove_photo_quality">
                        <field name="grove_image_width" />
                        <field name="grove_image_height" />
                        <field name="grove_image_low_res" />
                        <div
                            class="alert alert-warning"
                            role="alert"
                            colspan="2"
                            invisible="not grove_image_low_res"
                        >
                            This product photo's long edge is below the 1600px storefront minimum,
                            so it will render blurry on the product page hero (~1056px) and grid
                            cards. Upload a higher-resolution source (re-shoot list tracked in
                            GOL-689).
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- List filter for the published-but-incomplete plants the gate could not
         retroactively unpublish (GOL-2382). -->
    <record id="product_template_search_grove_listing" model="ir.ui.view">
        <field name="name">product.template.search.grove_listing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="grove_incomplete_listings"
                    string="Incomplete listings"
                    domain="[('website_published', '=', True), ('grove_listing_complete', '=', False), ('grove_gate_exempt', '=', False)]"
                />
            </xpath>
        </field>
    </record>

</odoo>
