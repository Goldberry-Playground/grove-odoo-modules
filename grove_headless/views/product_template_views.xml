<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Extend the product template form to show Grove headless fields -->
    <record id="product_template_form_view_grove" model="ir.ui.view">
        <field name="name">product.template.form.grove_headless</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Grove Headless" name="grove_headless">
                    <group>
                        <group string="Storefront">
                            <field name="grove_featured" />
                        </group>
                        <group string="SEO">
                            <field name="grove_seo_description" />
                        </group>
                    </group>
                    <group string="Storefront Guide" name="grove_guide">
                        <field name="grove_guide_ready" />
                        <div class="text-muted" colspan="2">
                            The species guide shown on the storefront is the
                            <b>Description for the website</b> field (Sales tab). It is drafted
                            automatically and stays hidden until you tick <b>Guide Approved
                            for Storefront</b>. Until then the storefront shows a "coming soon"
                            placeholder. To re-draft, clear the description first.
                        </div>
                    </group>
                    <group string="Photo Quality (storefront)" name="grove_photo_quality">
                        <field name="grove_image_width" />
                        <field name="grove_image_height" />
                        <field name="grove_image_low_res" />
                        <div
                            class="alert alert-warning"
                            role="alert"
                            colspan="2"
                            invisible="not grove_image_low_res"
                        >
                            This product photo's long edge is below the 1600px storefront minimum,
                            so it will render blurry on the product page hero (~1056px) and grid
                            cards. Upload a higher-resolution source (re-shoot list tracked in
                            GOL-689).
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
