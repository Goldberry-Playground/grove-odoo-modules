<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aspect coverage on the employee form (HR Settings tab). -->
    <record id="view_employee_form_grove_ops" model="ir.ui.view">
        <field name="name">hr.employee.form.grove_ops</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="grove_aspect_project_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
