<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_schedule_f_cashline_company" model="ir.rule">
        <field name="name">Schedule F cash line: multi-company</field>
        <field name="model_id" ref="model_grove_schedulef_cashline"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mirror_run_company" model="ir.rule">
        <field name="name">Month mirror: source company</field>
        <field name="model_id" ref="model_grove_mirror_run"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('source_company_id', 'in', company_ids)]</field>
    </record>
</odoo>
