<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grove_close_note_form" model="ir.ui.view">
        <field name="name">grove.close.note.form</field>
        <field name="model">grove.close.note</field>
        <field name="arch" type="xml">
            <form string="Month close note">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="create_uid" string="Written by"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_grove_close_note_list" model="ir.ui.view">
        <field name="name">grove.close.note.list</field>
        <field name="model">grove.close.note</field>
        <field name="arch" type="xml">
            <list string="Close notes">
                <field name="name"/>
                <field name="month"/>
                <field name="company_id"/>
                <field name="create_uid" string="Written by"/>
            </list>
        </field>
    </record>

    <record id="action_grove_close_note" model="ir.actions.act_window">
        <field name="name">Close notes</field>
        <field name="res_model">grove.close.note</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
