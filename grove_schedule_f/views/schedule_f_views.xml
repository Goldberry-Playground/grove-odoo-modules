<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_schedule_f_cashline_pivot" model="ir.ui.view">
        <field name="name">grove.schedulef.cashline.pivot</field>
        <field name="model">grove.schedulef.cashline</field>
        <field name="arch" type="xml">
            <pivot string="Schedule F by line">
                <field name="schedule_f_line" type="row"/>
                <field name="company_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_schedule_f_cashline_list" model="ir.ui.view">
        <field name="name">grove.schedulef.cashline.list</field>
        <field name="model">grove.schedulef.cashline</field>
        <field name="arch" type="xml">
            <list string="Schedule F cash lines" create="0" edit="0" delete="0">
                <field name="cash_date"/>
                <field name="company_id"/>
                <field name="schedule_f_line"/>
                <field name="account_id"/>
                <field name="enterprise"/>
                <field name="kind"/>
                <field name="source"/>
                <field name="amount" sum="Total"/>
                <field name="move_id"/>
            </list>
        </field>
    </record>

    <record id="view_schedule_f_cashline_search" model="ir.ui.view">
        <field name="name">grove.schedulef.cashline.search</field>
        <field name="model">grove.schedulef.cashline</field>
        <field name="arch" type="xml">
            <search string="Schedule F cash lines">
                <field name="schedule_f_line"/>
                <field name="account_id"/>
                <field name="enterprise"/>
                <field name="move_id"/>
                <filter name="source_bank" string="Bank" domain="[('source', '=', 'bank')]"/>
                <filter name="source_mirror" string="Mirror" domain="[('source', '=', 'mirror')]"/>
                <filter name="source_document" string="Invoices and bills" domain="[('source', '=', 'document')]"/>
                <separator/>
                <filter name="kind_income" string="Income" domain="[('kind', '=', 'income')]"/>
                <filter name="kind_expense" string="Expense" domain="[('kind', '=', 'expense')]"/>
                <separator/>
                <filter name="cash_date" string="Cash date" date="cash_date"/>
                <group>
                    <filter name="group_line" string="Schedule F line" context="{'group_by': 'schedule_f_line'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_enterprise" string="Enterprise" context="{'group_by': 'enterprise'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_schedule_f_cashlines" model="ir.actions.act_window">
        <field name="name">Schedule F by line</field>
        <field name="res_model">grove.schedulef.cashline</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{"pivot_measures": ["amount"], "pivot_row_groupby": ["schedule_f_line"], "pivot_column_groupby": ["company_id"]}</field>
    </record>

    <record id="action_unpaid_at_year_end" model="ir.actions.act_window">
        <field name="name">Unpaid at year end</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("state", "=", "posted"), ("move_type", "in", ["in_invoice", "in_refund", "out_invoice", "out_refund"]), ("payment_state", "not in", ["paid", "reversed"]), ("amount_residual", "!=", 0)]</field>
    </record>

    <record id="action_uncategorized_bank_lines" model="ir.actions.act_window">
        <field name="name">Uncategorized bank lines</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[("is_reconciled", "=", False)]</field>
    </record>
</odoo>
