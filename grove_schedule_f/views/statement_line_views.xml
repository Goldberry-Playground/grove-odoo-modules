<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_line_review_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.grove.review</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list string="Bank lines to review" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="grove_proposed_account_id"/>
                <field name="grove_proposed_enterprise_id"/>
                <field name="grove_proposed_model_id"/>
                <field name="grove_proposal_uncertain"/>
                <field name="grove_proposal_note"/>
                <field name="grove_proposal_state"/>
                <field name="grove_needs_review" column_invisible="1"/>
                <button name="action_grove_accept_proposal" type="object" string="Accept"
                        icon="fa-check" invisible="grove_proposal_state != 'proposed'"/>
                <button name="action_grove_reject_proposal" type="object" string="Reject"
                        icon="fa-times" invisible="grove_proposal_state != 'proposed'"/>
            </list>
        </field>
    </record>

    <record id="view_bank_line_review_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.search.grove.review</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search string="Bank lines to review">
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <filter name="needs_review" string="Needs review" domain="[('grove_needs_review', '=', True)]"/>
                <filter name="proposed" string="Proposed" domain="[('grove_proposal_state', '=', 'proposed')]"/>
                <filter name="uncertain" string="Uncertain" domain="[('grove_proposal_uncertain', '=', True)]"/>
                <group>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_lines_to_review" model="ir.actions.act_window">
        <field name="name">Bank lines to review</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_bank_line_review_list"/>
        <field name="search_view_id" ref="view_bank_line_review_search"/>
        <field name="domain">[("is_reconciled", "=", False)]</field>
        <field name="context">{"search_default_needs_review": 1, "search_default_group_journal": 1}</field>
    </record>
</odoo>
