<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose the grove_support company pointer on the livechat channel form so
         an operator can file a channel's chats under the right legal entity
         (GOL-3459). Shown only in multi-company deployments. -->
    <record id="im_livechat_channel_view_form_grove_company" model="ir.ui.view">
        <field name="name">im.livechat.channel.form.grove.company</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="company_id"
                           groups="base.group_multi_company"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
